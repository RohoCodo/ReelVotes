rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == "admin" ||
        request.auth.token.role == "super_admin"
      );
    }
    function sameTheater(theaterId) {
      return signedIn() &&
        (request.auth.token.role == "theater" || request.auth.token.role == "theater_user") &&
        request.auth.token.theaterId == theaterId;
    }

    // Events collection with subcollections for votes and movie summaries
    match /events/{eventId} {
      // Create event document if it doesn't exist
      allow read: if true;
      allow create, update, delete: if false;
      
      // Individual votes collection
      match /votes/{voteId} {
        allow read, write: if false;
      }
      
      // Movie summaries collection
      match /movies/{movieId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null;
      }

      match /voter_keys/{voterKeyId} {
        allow read, write: if false;
      }

      match /rate_limits/{rateLimitId} {
        allow read, write: if false;
      }
    }

    // Legacy votes collection (for backward compatibility if needed)
    match /votes/{docId} {
      allow read, write: if false;
    }

    match /reactions/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /takes/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /community_proposals/{docId} {
      allow read, write: if signedIn();
    }

    match /threads/{threadId} {
      allow read: if true;
      allow create, update, delete: if false;
      match /messages/{msgId} {
        allow read: if true;
        allow create, update, delete: if false;
      }
      match /members/{memberId} {
        allow read, write: if false;
      }
    }

    match /theaters/{theaterId} {
      allow read: if isAdmin() || sameTheater(theaterId);
      allow create, update, delete: if false;

      match /grossUploads/{uploadId} {
        allow read: if isAdmin() || sameTheater(theaterId);
        allow create, update, delete: if false;
      }
    }

    match /theaterUsers/{email} {
      allow read, write: if false;
    }
  }
}