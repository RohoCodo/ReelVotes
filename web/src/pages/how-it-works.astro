---
import Layout from "../layouts/Layout.astro";

const steps = [
  { icon: "🎬", title: "Start or join a campaign", body: "Campaigns are built around a theme and exactly 3 ranked movie choices." },
  { icon: "🤝", title: "Support level", body: "Tap I'd Watch This for interest or Back This Screening to commit to buying a ticket." },
  { icon: "✅", title: "Rights check at 70%", body: "When demand hits the trigger, theaters check licensing in priority order." },
  { icon: "🍿", title: "Funded to screening", body: "If rights are confirmed and backing reaches 100%, the screening gets scheduled." },
];

const faqs = [
  {
    q: "How many movies are in a campaign?",
    a: "Exactly three ranked choices are required in every campaign (Choice 1, 2, and 3).",
  },
  {
    q: "When does the theater check licensing?",
    a: "The theater licensing check is triggered once a campaign reaches about 70% of threshold in either backing or interest.",
  },
  {
    q: "When is my card charged for backing?",
    a: "Backing starts as a pre-authorization. It is only captured if the campaign fully funds and rights are confirmed.",
  },
  { q: "What if none of the three movies are available?", a: "The campaign closes and cards are not captured." },
  {
    q: "What if my theater isn't partnered?",
    a: "Use the Screenings page to let us know. The team follows up on demand from your city.",
    linkHref: "/showtimes",
    linkLabel: "Screenings",
  },
];
---

<Layout title="How it works" description="How ReelVotes turns community votes into real movie nights at independent theaters.">
  <section class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 class="text-center font-display text-4xl font-semibold text-ink sm:text-5xl">How ReelVotes works</h1>
    <p class="mt-4 text-center text-base text-ink-soft">Campaign-driven demand decides what gets screened.</p>

    <div class="mt-10 rounded-2xl border border-line bg-paper p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Campaign rules</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft">
        Every campaign has 3 ranked films, a Backing threshold, and an I'd Watch This threshold. Rights are checked after strong demand,
        and screenings only finalize when rights are confirmed and funding is complete.
      </p>
    </div>

    <div class="mt-4 rounded-2xl border border-line bg-paper p-6">
      <h2 class="font-display text-lg font-semibold text-ink">The mission</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft">
        ReelVotes helps independent theaters replace guesswork with validated demand. Community interest and committed backing
        are tracked separately so campaigns reflect both excitement and real ticket intent. That means more reliable programming,
        lower risk for theaters, and better odds your community actually gets the movies it rallies around.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {steps.map((step, index) => (
        <div
          class="rounded-2xl border border-line bg-cream-soft p-5 text-center hover:-translate-y-1 hover:border-marquee/25 hover:bg-paper hover:shadow-[0_12px_28px_-12px_rgba(48,59,107,0.18)]"
          data-reveal
          style={`transition-delay: ${index * 90}ms`}
        >
          <span class="text-2xl">{step.icon}</span>
          <h3 class="mt-2 text-sm font-semibold text-ink">{step.title}</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-ink-soft">{step.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-14" data-reveal>
      <h2 class="text-center font-display text-2xl font-semibold text-ink">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-line rounded-2xl border border-line bg-paper">
        {faqs.map((item) => (
          <details class="group p-5">
            <summary class="cursor-pointer list-none text-sm font-semibold text-ink marker:content-none">
              <span class="flex items-center justify-between gap-4">
                {item.q}
                <span class="shrink-0 text-ink-faint transition-transform group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-soft">
              {item.a}{" "}
              {item.linkHref && (
                <a href={item.linkHref} class="font-semibold text-marquee hover:underline">
                  {item.linkLabel}
                </a>
              )}
            </p>
          </details>
        ))}
      </div>
    </div>

    <div class="mt-12 text-center">
      <a
        href="/showtimes"
        class="inline-block rounded-full bg-marquee px-7 py-3.5 text-sm font-semibold text-white shadow-md shadow-marquee/30 transition-transform hover:-translate-y-0.5"
      >
        Browse live and past screenings
      </a>
    </div>
  </section>
</Layout>
