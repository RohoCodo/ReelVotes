---
import Layout from "../layouts/Layout.astro";
import EmailSignupForm from "../components/EmailSignupForm.tsx";
---

<Layout
  title="Get movie-night alerts"
  description="Join the ReelVotes email list for campaign momentum, winner confirmations, and ticket drops."
>
  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-wide text-marquee">ReelVotes Alerts</p>
      <h1 class="mt-3 font-display text-4xl font-semibold text-ink sm:text-5xl">Get the next movie night before everyone else</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">
        Join the list for updates that actually matter: when campaigns heat up, when the winner is locked,
        and when tickets drop.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-2xl rounded-3xl border border-line bg-paper p-6 sm:p-8" data-reveal>
      <EmailSignupForm
        eventId="marketing-join-page"
        submitLabel="Join the list"
        helperText="Unsubscribe anytime. We only email meaningful movie-night updates."
        successMessage="You're in 🎬 We'll send campaign and ticket alerts as they happen."
        client:visible
      />
    </div>

    <div class="mx-auto mt-8 grid max-w-2xl gap-3 text-sm text-ink-soft sm:grid-cols-3" data-reveal>
      <div class="rounded-2xl border border-line bg-cream-soft px-4 py-3">Campaign momentum alerts</div>
      <div class="rounded-2xl border border-line bg-cream-soft px-4 py-3">Winner confirmations</div>
      <div class="rounded-2xl border border-line bg-cream-soft px-4 py-3">Ticket release notifications</div>
    </div>

    <p class="mt-10 text-center" data-reveal>
      <a href="/campaigns" class="text-sm font-semibold text-marquee hover:underline">See live campaigns &rarr;</a>
    </p>
  </section>
</Layout>
