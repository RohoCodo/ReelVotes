---
import Layout from "../layouts/Layout.astro";

const process = [
  {
    title: "Community vote (5–7 days)",
    body: "Audiences vote on upcoming films from a curated selection.",
  },
  {
    title: "Licensing & confirmation (a few days)",
    body: "We secure screening rights for the winning title. Your theater always has final approval before anything is scheduled.",
  },
  {
    title: "Test ticket sales period",
    body: "We open early ticket sales to validate demand. A minimum threshold is set by your theater to ensure the screening is financially viable.",
  },
  {
    title: "Scheduling the screening",
    body: "If the sales threshold is met, we schedule the screening for a date you select in advance — typically a few weeks out.",
  },
];
---

<Layout title="For theaters" description="How ReelVotes partners with independent theaters to program movie nights with validated demand.">
  <section class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <span class="mx-auto block w-fit rounded-full border border-line bg-paper px-4 py-1.5 text-center text-xs font-semibold uppercase tracking-wide text-ink-soft">
      For theaters
    </span>
    <h1 class="mt-4 text-center font-display text-4xl font-semibold text-ink sm:text-5xl">
      How ReelVotes works with your theater
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-center text-base leading-relaxed text-ink-soft">
      We run a structured process designed to reduce risk and ensure demand before a screening is scheduled.
    </p>

    <ol class="mt-10 grid gap-4">
      {process.map((item, index) => (
        <li
          class="flex gap-4 rounded-2xl border border-line bg-paper p-5"
          data-reveal
          style={`transition-delay: ${index * 90}ms`}
        >
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-marquee-soft font-display text-sm font-semibold text-marquee">
            {index + 1}
          </span>
          <div>
            <h3 class="text-sm font-semibold text-ink">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{item.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-line bg-cream-soft p-6">
        <h2 class="font-display text-lg font-semibold text-ink">Marketing responsibilities</h2>
        <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-ink-soft">
          <li class="flex gap-2"><span class="text-marquee">&#8226;</span>We promote the voting process and drive audience participation.</li>
          <li class="flex gap-2"><span class="text-marquee">&#8226;</span>We help promote the test ticket sales period to help reach your minimum threshold.</li>
          <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Your theater continues to market the screening through your normal channels.</li>
        </ul>
      </div>

      <div class="rounded-2xl border border-line bg-cream-soft p-6">
        <h2 class="font-display text-lg font-semibold text-ink">How selections are determined</h2>
        <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-ink-soft">
          <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Community-submitted suggestions for themed or open votes.</li>
          <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Our ReelSuccess tool, which selects films based on performance data at similar theaters.</li>
          <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Curated lists based on what's performed well at comparable venues.</li>
          <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Full theater control — you can provide or approve every film selection.</li>
        </ul>
      </div>
    </div>

    <div id="submit" class="mt-4 rounded-2xl border border-line bg-paper p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Control & approvals</h2>
      <p class="mt-2 text-sm text-ink-soft">Your theater retains full control over:</p>
      <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-ink-soft">
        <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Which films are eligible for screening.</li>
        <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Final approval of any scheduled movie night.</li>
        <li class="flex gap-2"><span class="text-marquee">&#8226;</span>What dates and times screenings occur.</li>
        <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Control over ticket pricing.</li>
      </ul>
      <p class="mt-4 text-xs text-ink-faint">All screenings are subject to licensing availability and approval.</p>
    </div>

    <div class="mt-10 rounded-2xl border border-line bg-ink p-8 text-center" data-reveal>
      <h2 class="font-display text-2xl font-semibold text-white">Ready to partner with ReelVotes?</h2>
      <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-white/70">
        Submit your theater and screening details through our intake form to get started.
      </p>
      <a
        href="https://docs.google.com/forms/d/14KjwcZz1aS9keqQkdDddJEeagq-ipTcBGL8mbXe3UxE/viewform"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block rounded-full bg-marquee px-7 py-3.5 text-sm font-semibold text-white shadow-md shadow-marquee/30 transition-transform hover:-translate-y-0.5"
      >
        Submit your theater
      </a>
    </div>
  </section>
</Layout>
