---
import Layout from "../layouts/Layout.astro";
import CampaignExplorer from "../components/CampaignExplorer";
---

<Layout title="Discover" description="Explore movie campaigns and back the screenings you want to happen.">
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-wide text-marquee">Discover</p>
      <h1 class="mt-3 font-display text-4xl font-semibold text-ink sm:text-5xl">Find something worth seeing</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">
        Browse live campaigns, track momentum, and back screenings you want to happen in your market.
      </p>
    </div>

    <div class="mt-12" data-reveal>
      <CampaignExplorer layout="feed" client:load />
    </div>
  </section>
</Layout>
