---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Support" description="Get help with ReelVotes — voting issues, event questions, and technical problems.">
  <section class="mx-auto max-w-2xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 class="font-display text-3xl font-semibold text-ink sm:text-4xl">ReelVotes Support</h1>
    <p class="mt-2 text-sm text-ink-faint"><strong class="text-ink-soft">Last updated:</strong> August 23, 2026</p>

    <p class="mt-8 text-sm leading-relaxed text-ink-soft">
      Need help with ReelVotes? We're here to help with account access, voting issues, event questions, and
      technical problems.
    </p>

    <div class="mt-8 rounded-2xl border border-line bg-paper p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Contact support</h2>
      <p class="mt-2 text-sm text-ink-soft">
        Email us at <a href="mailto:rohan@reelvotes.com?subject=ReelVotes%20Support%20Request" class="font-semibold text-marquee hover:underline">
          rohan@reelvotes.com
        </a>
      </p>
      <div class="mt-4 rounded-xl border border-line bg-cream-soft px-4 py-3 text-sm text-ink-soft">
        Please include the event date, device type, and a short description of the issue so we can help faster.
      </div>
    </div>

    <div class="mt-4 rounded-2xl border border-line bg-paper p-6">
      <h2 class="font-display text-lg font-semibold text-ink">What we can help with</h2>
      <ul class="mt-3 space-y-2.5 text-sm text-ink-soft">
        <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Trouble submitting a vote</li>
        <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Questions about event listings or voting windows</li>
        <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Problems opening links or pages in the app/site</li>
        <li class="flex gap-2"><span class="text-marquee">&#8226;</span>Privacy or data requests related to ReelVotes</li>
      </ul>
    </div>

    <div class="mt-4 rounded-2xl border border-line bg-paper p-6">
      <h2 class="font-display text-lg font-semibold text-ink">Related pages</h2>
      <ul class="mt-3 space-y-2.5 text-sm">
        <li><a href="/privacy" class="font-semibold text-marquee hover:underline">Privacy Policy</a></li>
        <li><a href="/join" class="font-semibold text-marquee hover:underline">Email List Signup</a></li>
        <li><a href="/for-theaters" class="font-semibold text-marquee hover:underline">For Theaters</a></li>
      </ul>
    </div>

    <a href="/" class="mt-8 inline-block text-sm font-semibold text-marquee hover:underline">&larr; Back to ReelVotes</a>
  </section>
</Layout>
