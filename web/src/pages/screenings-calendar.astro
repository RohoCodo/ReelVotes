---
import Layout from "../layouts/Layout.astro";
import ShowtimesFlow from "../components/ShowtimesFlow.tsx";
---

<Layout title="Screenings calendar" description="Calendar view of screenings without theater selection.">
  <section class="mx-auto max-w-5xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="mx-auto mb-5 flex w-fit items-center gap-2 rounded-full border border-line bg-paper p-1.5">
      <a
        href="/screenings-calendar"
        aria-label="Open screenings calendar"
        title="Open calendar view"
        class="inline-flex items-center gap-1 rounded-full bg-marquee px-3 py-1.5 text-xs font-semibold text-white"
      >
        <span aria-hidden="true">📅</span>
        <span>Calendar</span>
      </a>
      <a
        href="/showtimes#previous"
        class="rounded-full px-4 py-1.5 text-xs font-semibold text-ink-soft transition-colors hover:text-marquee"
      >
        Previous
      </a>
      <a
        href="/showtimes#future"
        class="rounded-full px-4 py-1.5 text-xs font-semibold text-ink-soft transition-colors hover:text-marquee"
      >
        Future
      </a>
    </div>

    <h1 class="text-center font-display text-4xl font-semibold text-ink sm:text-5xl">Screenings Calendar</h1>

    <div class="mt-10">
      <ShowtimesFlow hideTheaterSelection={true} client:visible />
    </div>
  </section>
</Layout>
