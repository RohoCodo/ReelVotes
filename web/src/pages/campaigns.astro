---
import Layout from "../layouts/Layout.astro";
import CampaignExplorer from "../components/CampaignExplorer";
---

<Layout title="Community campaigns" description="Discover campaigns the community is trying to bring to local theaters.">
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-wide text-marquee">The Reel Community</p>
      <h1 class="mt-3 font-display text-4xl font-semibold text-ink sm:text-5xl">Campaigns</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">
        Every campaign starts with three movie choices competing for votes. The theater confirms availability after demand reaches
        the licensing trigger.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/create"
          data-create-campaign-top="true"
          class="w-full rounded-full bg-marquee px-7 py-3.5 text-center text-sm font-semibold text-white shadow-md shadow-marquee/30 transition-transform hover:-translate-y-0.5 sm:w-auto"
        >
          Create a campaign
        </a>
      </div>
    </div>

    <div id="campaigns-feed-anchor" class="mt-12" data-reveal>
      <CampaignExplorer layout="feed" showSearch={true} sortBy="votes-desc" client:load />
    </div>
  </section>

  <script is:inline>
    function revealFirstCampaignOnLoad() {
      if (window.location.pathname !== "/campaigns" || window.location.hash) {
        return;
      }

      const anchor = document.getElementById("campaigns-feed-anchor");
      if (!anchor) {
        return;
      }

      let settled = false;

      const positionFeed = () => {
        if (settled) {
          return true;
        }

        const firstCampaign = anchor.querySelector("article[id]");
        if (!firstCampaign) {
          return false;
        }

        const rect = firstCampaign.getBoundingClientRect();
        const desiredTop = Math.max(120, window.innerHeight - 260);
        if (rect.top > desiredTop) {
          const nextScrollTop = Math.max(0, window.scrollY + rect.top - desiredTop);
          window.scrollTo({ top: nextScrollTop, left: 0, behavior: "auto" });
        }

        settled = true;
        return true;
      };

      if (positionFeed()) {
        return;
      }

      const observer = new MutationObserver(() => {
        if (positionFeed()) {
          observer.disconnect();
        }
      });

      observer.observe(anchor, { childList: true, subtree: true });
      window.setTimeout(() => observer.disconnect(), 5000);
    }

    document.addEventListener("astro:page-load", revealFirstCampaignOnLoad);
    revealFirstCampaignOnLoad();
  </script>
</Layout>
