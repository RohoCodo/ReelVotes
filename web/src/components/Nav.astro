---
const primaryLinks = [
  { href: "/how-it-works", label: "How It Works" },
  { href: "/showtimes", label: "Showtimes" },
  { href: "/for-theaters", label: "For Theaters" },
];

const utilityLinks = [
  { href: "/suggest", label: "Suggest a Movie" },
  { href: "/support", label: "Support" },
  { href: "/privacy", label: "Privacy Policy" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const allMobileLinks = [...primaryLinks, { href: "/chat", label: "Movie Chat" }, ...utilityLinks];
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-cream/90 backdrop-blur-md">
  <!-- Primary row -->
  <div class="flex items-center justify-between gap-6 px-5 py-4 sm:px-8 lg:px-12">
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <img src="/icon.png" alt="" class="h-8 w-8 rounded-full object-cover" />
      <span class="font-sans text-xl font-extrabold tracking-tight text-ink">Reel<span class="text-marquee">Votes</span></span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {primaryLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "relative py-1.5 text-sm font-medium transition-colors hover:text-marquee",
            currentPath === link.href
              ? "text-marquee after:absolute after:inset-x-0 after:-bottom-[13px] after:h-0.5 after:rounded-full after:bg-marquee"
              : "text-ink-soft",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-5 md:flex">
      <a
        href="/chat"
        class:list={[
          "flex items-center gap-1.5 text-sm font-medium transition-colors hover:text-marquee",
          currentPath === "/chat" ? "text-marquee" : "text-ink-soft",
        ]}
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </svg>
        Movie Chat
      </a>
      <a
        href="/showtimes"
        class="rounded-full bg-marquee px-5 py-2.5 text-sm font-semibold text-white shadow-sm shadow-marquee/30 transition-transform hover:-translate-y-0.5 hover:shadow-md hover:shadow-marquee/40"
      >
        Vote Now
      </a>
    </div>

    <button
      id="navToggleBtn"
      type="button"
      class="grid h-9 w-9 shrink-0 cursor-pointer place-items-center rounded-full border border-line text-ink md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobileNavPanel"
    >
      <svg class="nav-icon-open h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      <svg class="nav-icon-close hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <!-- Utility row -->
  <div class="hidden border-t border-line/70 bg-cream-soft/70 md:block">
    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-6 px-5 py-2 sm:px-8 lg:px-12">
      <span aria-hidden="true"></span>
      <a href="/showtimes" class="flex items-center gap-1.5 whitespace-nowrap text-xs font-medium text-ink-soft transition-colors hover:text-marquee">
        <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        Now programming with The New Parkway Theater &middot; Oakland, CA
      </a>
      <nav class="flex items-center justify-end gap-5">
        {utilityLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-xs font-medium transition-colors hover:text-marquee",
              currentPath === link.href ? "text-marquee" : "text-ink-faint",
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div
    id="mobileNavPanel"
    class="fixed inset-x-0 top-[65px] z-40 hidden max-h-[calc(100vh-65px)] flex-col overflow-y-auto border-b border-line bg-cream px-5 py-5 shadow-lg md:hidden"
  >
    {allMobileLinks.map((link) => (
      <a
        href={link.href}
        class:list={[
          "border-b border-line/60 py-3.5 text-base font-medium",
          currentPath === link.href ? "text-marquee" : "text-ink",
        ]}
      >
        {link.label}
      </a>
    ))}
    <a
      href="/showtimes"
      class="mt-4 rounded-full bg-marquee px-5 py-3 text-center text-sm font-semibold text-white"
    >
      Vote Now
    </a>
  </div>
</header>

<script>
  // Re-bound on every astro:page-load (fires on first load AND after every
  // view-transition navigation) — with <ClientRouter /> swapping in fresh
  // DOM per page, a plain top-level script here would only ever bind to
  // the very first page's nav elements and silently go dead after that.
  function initNavToggle() {
    const toggleBtn = document.getElementById("navToggleBtn");
    const panel = document.getElementById("mobileNavPanel");
    if (!toggleBtn || !panel) return;

    toggleBtn.addEventListener("click", () => {
      const isOpen = panel.classList.toggle("flex");
      panel.classList.toggle("hidden");
      toggleBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      toggleBtn.querySelector(".nav-icon-open")?.classList.toggle("hidden", isOpen);
      toggleBtn.querySelector(".nav-icon-close")?.classList.toggle("hidden", !isOpen);
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        panel.classList.add("hidden");
        panel.classList.remove("flex");
        toggleBtn.setAttribute("aria-expanded", "false");
        toggleBtn.querySelector(".nav-icon-open")?.classList.remove("hidden");
        toggleBtn.querySelector(".nav-icon-close")?.classList.add("hidden");
      });
    });
  }

  document.addEventListener("astro:page-load", initNavToggle);
</script>
