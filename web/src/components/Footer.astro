---
const columns = [
  {
    title: "Moviegoers",
    links: [
      { href: "/showtimes", label: "Browse screenings" },
      { href: "/how-it-works", label: "How it works" },
      { href: "/suggest", label: "Suggest a movie" },
      { href: "/join", label: "Join email list" },
    ],
  },
  {
    title: "Theaters",
    links: [
      { href: "/for-theaters", label: "Partner with ReelVotes" },
      { href: "/for-theaters#submit", label: "Submit a screening" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/support", label: "Support" },
      { href: "/privacy", label: "Privacy Policy" },
    ],
  },
];
---

<footer class="border-t border-line bg-cream-soft">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid grid-cols-2 gap-10 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <a href="/" class="flex items-center">
          <span class="font-sans text-lg font-extrabold tracking-tight text-ink">Reel<span class="text-marquee">Votes</span></span>
        </a>
        <p class="mt-3 max-w-[220px] text-sm leading-relaxed text-ink-soft">
          Community-picked movie nights at independent theaters you love.
        </p>
      </div>

      {columns.map((col) => (
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-faint">{col.title}</p>
          <ul class="mt-3 space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink-soft transition-colors hover:text-marquee">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-line pt-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} ReelVotes. All rights reserved.</p>
      <p>Made for independent theaters and the people who show up for them.</p>
    </div>
  </div>
</footer>
