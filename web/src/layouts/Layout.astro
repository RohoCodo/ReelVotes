---
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "ReelVotes helps independent theaters program movie nights the community actually votes for — and shows up to.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-MXXR4PXT");
    </script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} · ReelVotes</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-MXXR4PXT"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <!--
      Ambient background wash — fixed to the viewport (not clipped to any
      one section), so it stays visible as a soft glow behind whatever
      content is currently on screen, all the way down the page, instead
      of cutting off hard at a section boundary.
    -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-24 right-[-10%] h-96 w-96 rounded-full bg-marquee/10 blur-3xl"></div>
      <div class="absolute top-40 left-[-10%] h-80 w-80 rounded-full bg-rose/10 blur-3xl"></div>
    </div>

    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // GTM's own gtm.js event covers the very first (hard) page load, but
      // <ClientRouter/> swaps the DOM for every later navigation without a
      // full reload — GTM would never see those as pageviews otherwise. Push
      // a virtual pageview for every load after the first.
      let isFirstLoad = true;
      document.addEventListener("astro:page-load", () => {
        if (isFirstLoad) {
          isFirstLoad = false;
        } else {
          const w = window as unknown as { dataLayer?: Record<string, unknown>[] };
          w.dataLayer = w.dataLayer || [];
          w.dataLayer.push({ event: "virtualPageview", page_path: location.pathname + location.search });
        }
      });

      // Progressive-enhancement scroll reveal — see the `js-reveal` rules in
      // global.css. Re-runs after every view-transition navigation (Astro
      // swaps the DOM without a full reload, so a plain top-level script
      // would only ever fire once) via astro:page-load, which also fires
      // on the very first load.
      document.addEventListener("astro:page-load", () => {
        document.documentElement.classList.add("js-reveal");

        const revealTargets = document.querySelectorAll("[data-reveal]:not(.is-visible)");
        if (revealTargets.length > 0 && "IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
          );
          revealTargets.forEach((el) => observer.observe(el));
        } else {
          revealTargets.forEach((el) => el.classList.add("is-visible"));
        }
      });
    </script>
  </body>
</html>
