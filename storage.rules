rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin'
      );
    }

    function sameTheater(theaterId) {
      return signedIn() &&
        (request.auth.token.role == 'theater' || request.auth.token.role == 'theater_user') &&
        request.auth.token.theaterId == theaterId;
    }

    match /box-office-grosses/{theaterId}/{businessDate}/{fileName} {
      allow read: if isAdmin() || sameTheater(theaterId);

      allow write: if (isAdmin() || sameTheater(theaterId))
        && request.resource != null
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && fileName.matches('.*\\.pdf$');

      allow delete: if isAdmin() || sameTheater(theaterId);
    }
  }
}
